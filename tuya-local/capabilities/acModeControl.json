{
  "name": "AC Mode Control",
  "attributes": {
    "mode": {
      "schema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          }
        },
        "required": [
          "value"
        ],
        "additionalProperties": false
      },
      "setter": "setMode"
    },
    "supportedModes": {
      "schema": {
        "type": "object",
        "properties": {
          "value": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "value"
        ],
        "additionalProperties": false
      }
    }
  },
  "commands": {
    "setMode": {
      "name": "setMode",
      "arguments": [
        {
          "name": "mode",
          "optional": false,
          "schema": {
            "type": "string",
            "enum": [
              "auto",
              "cool",
              "dry",
              "fanOnly",
              "heat"
            ]
          }
        }
      ]
    }
  }
}
